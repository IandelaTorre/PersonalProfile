---
import { getLangFromUrl } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);

const pathname = Astro.url.pathname;
const normalized =
  pathname.length > 1 && pathname.endsWith("/")
    ? pathname.slice(0, -1)
    : pathname;

// Path without the /es prefix, shared by both languages
const basePath =
  lang === "es" ? normalized.replace(/^\/es/, "") || "/" : normalized;

const enUrl = basePath;
const esUrl = basePath === "/" ? "/es" : `/es${basePath}`;

const links = [
  { code: "es", label: "ES", href: esUrl },
  { code: "en", label: "EN", href: enUrl },
] as const;
---

<nav
  class="lang-switch relative inline-flex items-center rounded-full bg-gray-100 p-1 border border-gray-200 dark:bg-white/5 dark:border-white/10"
  data-active={lang}
  aria-label="Language"
>
  {
    links.map((link) => (
      <a
        href={link.href}
        aria-current={link.code === lang ? "page" : undefined}
        class="relative z-10 w-10 py-1 text-center rounded-full text-xs font-medium text-gray-500 transition-colors duration-300 dark:text-neutral-400"
      >
        {link.label}
      </a>
    ))
  }
</nav>

<style>
  /* Sliding pill behind the active language */
  .lang-switch::before {
    content: "";
    position: absolute;
    top: 0.25rem;
    bottom: 0.25rem;
    left: 0.25rem;
    width: 2.5rem;
    border-radius: 9999px;
    background: var(--color-blue-500, #3b82f6);
    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
    transition: translate 300ms cubic-bezier(0.34, 1.3, 0.64, 1);
  }

  .lang-switch[data-active="en"]::before {
    translate: 100% 0;
  }

  /* The pill follows the hovered option, then springs back */
  .lang-switch:has(a:first-child:hover)::before {
    translate: 0 0;
  }

  .lang-switch:has(a:last-child:hover)::before {
    translate: 100% 0;
  }

  /* Text turns white when the pill is (or slides) under it */
  .lang-switch a[aria-current="page"],
  .lang-switch a:hover {
    color: white;
  }

  .lang-switch:has(a:hover) a[aria-current="page"]:not(:hover) {
    color: var(--color-gray-500, #6b7280);
  }

  @media (prefers-color-scheme: dark) {
    .lang-switch:has(a:hover) a[aria-current="page"]:not(:hover) {
      color: var(--color-neutral-400, #a3a3a3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lang-switch::before,
    .lang-switch a {
      transition: none;
    }
  }
</style>
