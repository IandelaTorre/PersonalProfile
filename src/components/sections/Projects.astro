---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import Card from "../ui/Card.astro";
import Badge from "../ui/Badge.astro";
import { getLang, useTranslations } from "../../i18n/utils";
import { getTagColor } from "../../lib/badge-colors";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const projects = (await getCollection("projects", ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order);
---

<section
  id="projects"
  class="max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 mx-auto"
>
  <div class="max-w-2xl mx-auto text-center mb-10 lg:mb-14">
    <h2 class="text-2xl font-bold md:text-4xl md:leading-tight dark:text-white">
      {t("projects.title")}
    </h2>
    <p class="mt-1 text-gray-600 dark:text-neutral-400">
      {t("projects.viewAll")}
    </p>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {
      projects.map((project, i) => (
        <Card
          href={project.data.url}
          target="_blank"
          rel="noopener noreferrer"
          class="reveal h-full"
          style={`--reveal-delay: ${(i % 3) * 120}ms`}
        >
          <div class="aspect-w-16 aspect-h-9 mb-4 overflow-hidden rounded-xl">
            <Image
              class="w-full h-48 object-cover rounded-xl transition-transform duration-500 hover:scale-105"
              src={project.data.image}
              alt={project.data.title}
              width={768}
              height={384}
              loading="lazy"
            />
          </div>
          <div class="flex flex-col h-full">
            <div class="flex justify-between items-center mb-2">
              <Badge label={project.data.type} color="gray" />
            </div>
            <h3 class="text-xl font-bold text-gray-800 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-500">
              {project.data.title}
            </h3>
            <p class="mt-3 text-gray-600 dark:text-neutral-400 flex-grow">
              {project.data.description[lang]}
            </p>
            <div class="mt-4 flex flex-wrap gap-2">
              {project.data.tags.map((tag) => (
                <Badge label={tag} color={getTagColor(tag)} />
              ))}
            </div>
          </div>
        </Card>
      ))
    }
  </div>
  <p class="mt-6 text-sm text-center text-gray-600 dark:text-neutral-400">
    {t("projects.more")}
    <a
      href={getRelativeLocaleUrl(lang, "/projects")}
      class="relative font-medium text-blue-400 hover:text-blue-300
            bg-gradient-to-r from-blue-400 to-sky-400
            bg-[length:0%_2px] bg-left-bottom bg-no-repeat
            transition-all duration-300 ease-out
            hover:bg-[length:100%_2px]"
    >
      {t("projects.ctaProjects")}</a
    >.
  </p>
</section>
