---
import Badge from "../ui/Badge.astro";
import SpotlightCard from "../ui/SpotlightCard.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { getLang, useTranslations } from "../../i18n/utils";
import type { BadgeColor } from "../../lib/badge-colors";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const stack: { category: string; items: { name: string; color: BadgeColor }[] }[] = [
  {
    category: t("techStack.ios"),
    items: [
      { name: "Swift", color: "orange" },
      { name: "SwiftUI", color: "blue" },
      { name: "UIKit", color: "indigo" },
      { name: "Storyboards", color: "indigo" },
      { name: "Auto Layout", color: "indigo" },
      { name: "Stack Views", color: "indigo" },
      { name: "Clean Architecture", color: "slate" },
      { name: "MVVM", color: "slate" },
      { name: "Coordinators", color: "slate" },
      { name: "Dependency Injection", color: "slate" },
      { name: "Async/Await", color: "blue" },
      { name: "Combine", color: "blue" },
      { name: "Local Persistence", color: "green" },
      { name: "Unit Tests (XCTest)", color: "amber" },
    ],
  },
  {
    category: t("techStack.frontend"),
    items: [
      { name: "React", color: "cyan" },
      { name: "TypeScript", color: "blue" },
      { name: "JavaScript", color: "yellow" },
      { name: "Astro", color: "orange" },
      { name: "React Router", color: "gray" },
      { name: "Redux", color: "purple" },
      { name: "Tailwind CSS", color: "cyan" },
      { name: "Ant Design", color: "blue" },
      { name: "JWT Auth", color: "zinc" },
      { name: "Responsive Design", color: "zinc" },
    ],
  },
  {
    category: t("techStack.backend"),
    items: [
      { name: "NestJS", color: "red" },
      { name: "Node.js", color: "green" },
      { name: "Express", color: "gray" },
      { name: "TypeScript", color: "blue" },
      { name: "Prisma", color: "purple" },
      { name: "Drizzle ORM", color: "lime" },
      { name: "Serverless Framework", color: "red" },
      { name: "REST APIs", color: "zinc" },
      { name: "JWT Auth", color: "zinc" },
      { name: "Pino Logger", color: "amber" },
    ],
  },
  {
    category: t("techStack.databases"),
    items: [
      { name: "SQL", color: "gray" },
      { name: "PostgreSQL", color: "blue" },
      { name: "Firebase", color: "amber" },
      { name: "Database Design", color: "gray" },
    ],
  },
  {
    category: t("techStack.tooling"),
    items: [
      { name: "Xcode", color: "blue" },
      { name: "VS Code", color: "blue" },
      { name: "Git", color: "orange" },
      { name: "Docker", color: "blue" },
      { name: "CI/CD", color: "green" },
      { name: "GitHub Actions", color: "gray" },
      { name: "AWS (Basics)", color: "amber" },
      { name: "Postman", color: "orange" },
    ],
  },
];
---

<section
  id="tech-stack"
  class="max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 mx-auto"
>
  <SectionHeader number="01" title={t("techStack.title")} />

  <div class="flex flex-wrap justify-center gap-6" id="tech-stack-grid">
    {
      stack.map((group) => (
        <SpotlightCard
          size={400}
          class="w-full sm:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)]"
        >
          <h3 class="text-lg font-bold text-gray-800 dark:text-white mb-3">
            {group.category}
          </h3>
          <div class="flex flex-wrap gap-2">
            {group.items.map((item) => (
              <Badge label={item.name} color={item.color} />
            ))}
          </div>
        </SpotlightCard>
      ))
    }
  </div>
</section>
