---
interface Props {
  class?: string;
  /** Radius of the hover spotlight, in px */
  size?: number;
}

const { class: className, size = 500 } = Astro.props;
---

<div
  class:list={[
    "spotlight-card relative group flex flex-col bg-white dark:bg-neutral-900 border border-gray-200 dark:border-neutral-800 shadow-sm rounded-xl p-4 md:p-5 overflow-hidden",
    className,
  ]}
  style={`--spotlight-size: ${size}px`}
>
  <div
    class="pointer-events-none absolute -inset-px rounded-xl opacity-0 transition duration-300 group-hover:opacity-100"
    style="background: radial-gradient(var(--spotlight-size) circle at var(--mouse-x) var(--mouse-y), rgba(59, 130, 246, 0.4), transparent 40%);"
  >
  </div>
  <div class="relative z-10 flex flex-col h-full">
    <slot />
  </div>
</div>

<script>
  const cards = document.querySelectorAll<HTMLElement>(".spotlight-card");

  cards.forEach((card) => {
    card.addEventListener("mousemove", (e) => {
      const rect = card.getBoundingClientRect();
      card.style.setProperty("--mouse-x", `${e.clientX - rect.left}px`);
      card.style.setProperty("--mouse-y", `${e.clientY - rect.top}px`);
    });
  });
</script>
